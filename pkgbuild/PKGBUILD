# Maintainer: Fabian Bornschein <fabiscafe@archlinux.org>
# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Contributor: Jan de Groot <jgc@archlinux.org>

# This version modified to add embedded terminal support
# Maintainer: Bruno Goncalves <biglinux.com.br>
# Maintainer: Tales A. Mendonça <communitybig.org>

pkgbase=big-nautilus
pkgname=big-nautilus
pkgdesc="File manager for BigLinux - GNOME Files with an embedded terminal, colour tags and more"
pkgver=51.1
pkgrel=1
conflicts=('nautilus' 'nautilus-with-terminal')
provides=('nautilus')
replaces=('nautilus' 'nautilus-with-terminal')
url="https://github.com/big-comm/${pkgname}"
arch=(x86_64)
license=(GPL-3.0-or-later)
# Nota: não habilitar options=(debug) aqui. O pipeline resolve o artefato com
#   find . -iname "$pkgname*.pkg.tar.zst"
# e o nome big-nautilus-debug casa com esse mesmo padrão, então a
# variável full_pkgname vira multilinha, a escrita em $GITHUB_ENV é recusada e
# o job falha depois de já ter construído os pacotes. Para depurar, construa
# localmente com options=(debug) em uma cópia deste PKGBUILD.
depends=(
  big-search
  cairo
  dconf
  gcc-libs
  gdk-pixbuf2
  'glib2>=2.89.0'
  glibc
  glycin
  glycin-gtk4
  gnome-autoar
  gnome-desktop-4
  graphene
  gst-plugins-base-libs
  gstreamer
  'gtk4>=1:4.24.0'
  gvfs
  hicolor-icon-theme
  icu
  json-glib
  libadwaita
  libcloudproviders
  libgexiv2
  libportal
  libportal-gtk4
  libx11
  localsearch
  pango
  tinysparql
  vte4
  wayland
  xdg-user-dirs-gtk
)
makedepends=(
  appstream
  blueprint-compiler
  gi-docgen
  git
  glib2-devel
  gobject-introspection
  meson
)
source=("git+${url}.git")
b2sums=('SKIP')
install=pkgbuild.install

build() {
  # docs also installs the man pages.
  local meson_options=(
    -D docs=true
    -D selinux=disabled
  )

  # --wrap-mode=default overrides arch-meson's --wrap-mode=nodownload: Nautilus
  # builds libgxdp, its portal helper, from a subproject that has no package,
  # and blueprint-compiler comes the same way when the chroot ships one older
  # than required (>= 0.19.0). The build needs network for both.
  arch-meson big-nautilus build "${meson_options[@]}" --wrap-mode=default
  meson compile -C build
}

package() {
  depends+=(libnautilus-extension.so)
  groups=(gnome)

  meson install -C build --destdir "$pkgdir"

  # The extension library and its API reference are the ones GNOME Files
  # builds, unchanged, and the libnautilus-extension packages own these paths.
  rm -r "$pkgdir"/usr/include \
    "$pkgdir"/usr/lib/girepository-1.0 \
    "$pkgdir"/usr/lib/libnautilus-extension.so* \
    "$pkgdir"/usr/lib/pkgconfig \
    "$pkgdir"/usr/share/doc \
    "$pkgdir"/usr/share/gir-1.0
}

