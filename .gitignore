build/
.*/
!.gitlab/

# Ignore meson's subprojects folder, but keep wrap files and overlays
/subprojects/*
!/subprojects/*.wrap
!/subprojects/packagefiles/

# Ignore auto generated files
/.buildconfig

# Ignore temporary files
*.orig
*~

# Ignore captures
/*.syscap
/heaptrack.nautilus.*

# Ignore build directory and maintenance scripts
/builddir
/update-nautilus-fork.sh
